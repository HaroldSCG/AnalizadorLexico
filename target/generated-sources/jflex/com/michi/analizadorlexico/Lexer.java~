          case 38:
            { return err("ERROR_NUMERO_MALFORMADO");
            }
          // fall through
          case 95: break;
          case 39:
            { commentDepth = 1;
                                       commentLine0 = yyline;
                                       commentCol0  = yycolumn;
                                       yybegin(COMMENT_BLOCK);
            }
          // fall through
          case 96: break;
          case 40:
            { /* comentario de linea */
            }
          // fall through
          case 97: break;
